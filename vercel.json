{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "git clone --filter=blob:none https://github.com/PascalPixel/alchemy /tmp/alchemy && ALCHEMY=/tmp/alchemy bun run build",
  "outputDirectory": "dist/public",
  "trailingSlash": false,
  "redirects": [
    { "source": "/tbs/source/fields", "destination": "/tbs/source/structs", "permanent": true },
    { "source": "/tbs/source/fields/:path*", "destination": "/tbs/source/structs", "permanent": true },
    { "source": "/tbs/source/globals", "destination": "/tbs/source", "permanent": true },
    { "source": "/tbs/source/globals/:path*", "destination": "/tbs/source", "permanent": true },
    {
      "source": "/tla",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tbs/user_interface",
      "destination": "/tbs/interface",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path(.*)\\.md",
      "destination": "/llms.mdx/:path/content.md"
    },
    {
      "source": "/places/:path*",
      "destination": "https://n2k4znkfbewwaw0l.public.blob.vercel-storage.com/places/:path*"
    },
    {
      "source": "/abilities/:path*",
      "destination": "https://n2k4znkfbewwaw0l.public.blob.vercel-storage.com/abilities/:path*"
    },
    {
      "source": "/guides/:path*",
      "destination": "https://n2k4znkfbewwaw0l.public.blob.vercel-storage.com/guides/:path*"
    },
    {
      "source": "/story/:path*",
      "destination": "https://n2k4znkfbewwaw0l.public.blob.vercel-storage.com/story/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(places|abilities|guides|story)/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/(places|abilities|guides|story)/:path*",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=3600"
        }
      ]
    }
  ]
}
