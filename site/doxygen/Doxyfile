# Doxygen reads one game's C and writes XML; scripts/content.ts turns the XML
# into the reference pages under content/docs/<game>/source. `bun run content`
# runs it once per game, both at once, from docs/, with these set:
#   GAME        tbs or tla
#   GAME_TLA    0 for tbs, 1 for tla
#   EDITION     the English edition's macro, TBS_EDITION_EN or TLA_EDITION_EN
# Its input is .doxygen/src, the game's src and include as scripts/filter.ts
# leaves them (every line keeps its number), stripped back to games/<game>/...

PROJECT_NAME           = "Alchemy $(GAME)"
OUTPUT_DIRECTORY       = .doxygen/$(GAME)
GENERATE_XML           = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
XML_PROGRAMLISTING     = NO
QUIET                  = YES
WARNINGS               = NO
WARN_IF_UNDOCUMENTED   = NO

INPUT                  = .doxygen/src/games/$(GAME)/src \
                         .doxygen/src/games/$(GAME)/include
FILE_PATTERNS          = *.c *.h
RECURSIVE              = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .doxygen/src

# The code is documented in Doxygen's line form (///, /// @file, ///<); a
# comment's first sentence is its brief.
OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = NO
TYPEDEF_HIDES_STRUCT   = NO
SORT_MEMBER_DOCS       = NO
SOURCE_BROWSER         = NO

# #if branches as the English edition builds them. The values are set rather
# than read from edition.h and version.h, as the Doxygen trial sets them;
# __attribute__ is removed so a packed struct is not read as globals.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = NO
PREDEFINED             = "__attribute__(x)=" \
                         LANGUAGE_JAPANESE=0 LANGUAGE_ENGLISH=1 \
                         LANGUAGE_GERMAN=2 LANGUAGE_SPANISH=3 \
                         LANGUAGE_FRENCH=4 LANGUAGE_ITALIAN=5 LANGUAGE=1 \
                         $(EDITION)=1 GAME_TLA=$(GAME_TLA) TBS_PATCH_LEVEL=1 \
                         TBS_PATCH_1=1 TBS_PATCH_2=0 TBS_PATCH_3=0 TBS_PATCH_4=0

HAVE_DOT               = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
