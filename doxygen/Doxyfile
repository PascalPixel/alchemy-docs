# The settings both games' runs share; Doxyfile.tbs and Doxyfile.tla add
# each game's inputs, output folder and #if values. One run per game keeps
# their same-named files, structures and functions apart. Run from the
# repository root with make docs. Only settings that differ from Doxygen's
# defaults are listed. Built with Doxygen 1.18.

PROJECT_NAME           = "Alchemy"

HTML_OUTPUT            = .
CREATE_SUBDIRS         = NO
FULL_PATH_NAMES        = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
# README sections become tree entries and links, with GitHub's heading ids.
TOC_INCLUDE_HEADINGS   = 2
MARKDOWN_ID_STYLE      = GITHUB
TYPEDEF_HIDES_STRUCT   = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO

# What to read
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
# As AGENTS.md has it: a comment's first sentence is its brief.
JAVADOC_AUTOBRIEF      = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SHOW_USED_FILES        = NO
SHOW_INCLUDE_FILES     = NO
FILE_PATTERNS          = *.c *.h *.dox
RECURSIVE              = YES
# The READMEs come in through \includedoc of the copies make docs writes to
# $(SRC), never as .md input: Doxygen 1.18.0 crashes (SIGBUS in its
# comment scanner) on about half the runs that read a .md file.
EXAMPLE_PATH           = $(SRC) .

# Sources, cross-referenced: who calls each function, not everything it uses
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCES_RELATION    = NO
REFERENCES_LINK_SOURCE = YES
SOURCE_TOOLTIPS        = YES
VERBATIM_HEADERS       = NO

# #if branches as the English editions build them, each game setting its
# own values (set rather than read from edition.h and version.h, since
# following every #include multiplies the build time). __attribute__ goes
# so a packed struct is not read as globals, CAMELOT_ASM so a proven
# handwritten helper reads as the function it is, and the macros that
# generate functions are expanded so each generated function has its page.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = NO
PREDEFINED             = "__attribute__(x)=" "CAMELOT_ASM(x)=" \
                         LANGUAGE_JAPANESE=0 LANGUAGE_ENGLISH=1 \
                         LANGUAGE_GERMAN=2 LANGUAGE_SPANISH=3 \
                         LANGUAGE_FRENCH=4 LANGUAGE_ITALIAN=5 LANGUAGE=1
EXPAND_AS_DEFINED      = DEFINE_EFFECT_KIND SCRIPT_DEFINE_OPERAND_WORD \
                         SCRIPT_DEFINE_OPERAND_NARROW SCRIPT_DEFINE_OPERAND_ADDRESS \
                         SCRIPT_DEFINE_FLAG_COMMAND IO_QUEUE_DEFINE_WRITE \
                         DEFINE_QUEUE_IO_WRITE FADE_DEFINE_BLEND DEFINE_TICK_STATUS \
                         DEFINE_GET_RESOURCE_DIMENSIONS RESOURCE_DEFINE_DECODE \
                         UI_DEFINE_SET_GRID_COLUMN SERIAL_DEFINE_WAIT \
                         PARTY_DEFINE_ADJUST OBJECT_DISPATCH_DEFINE_APPLY \
                         FOUR_OBJECT_MOTION_DEFINE_RELEASE DEFINE_TICK_MODIFIER \
                         DEFINE_SHRINK_AND_DESTROY DEFINE_ITEM_BREAK_EFFECT \
                         DEFINE_ADJUST_CAMERA

# HTML in the progress images' look
GENERATE_HTML          = YES
HTML_HEADER            = $(DOCS)/header.html
HTML_FOOTER            = $(DOCS)/footer.html
LAYOUT_FILE            = $(DOCS)/DoxygenLayout.xml
HTML_STYLESHEET        = $(DOCS)/alchemy.css
HTML_EXTRA_FILES       = $(DOCS)/weyard-emoji.otf \
                         $(DOCS)/weyard-emoji-LICENSE \
                         $(DOCS)/weyard-emoji-source.txt \
                         $(SRC)/fonts/weyard-sans.otf \
                         $(SRC)/fonts/weyard-sans-bold.otf \
                         $(SRC)/fonts/weyard-sans-italic.otf \
                         $(SRC)/fonts/weyard-sans-bold-italic.otf \
                         $(SRC)/fonts/weyard-mono.otf \
                         $(SRC)/fonts/weyard-mono-bold.otf \
                         $(SRC)/fonts/weyard-mono-italic.otf \
                         $(SRC)/fonts/weyard-mono-bold-italic.otf \
                         $(SRC)/fonts/weyard-mono-ja.otf \
                         $(SRC)/fonts/weyard-mono-ja-bold.otf \
                         $(DOCS)/panel-raised.svg \
                         $(DOCS)/panel-side.svg \
                         $(DOCS)/panel-raised-night.svg \
                         $(DOCS)/panel-side-night.svg \
                         $(DOCS)/caret-closed.svg \
                         $(DOCS)/caret-open.svg \
                         $(DOCS)/close.svg \
                         $(DOCS)/diamond.svg \
                         $(DOCS)/search-glass.png
HTML_COLORSTYLE        = LIGHT
HTML_DYNAMIC_SECTIONS  = NO
HTML_COPY_CLIPBOARD    = NO
HTML_CODE_FOLDING      = NO
HTML_INDEX_NUM_ENTRIES = 1
# The index menu is on so that Doxygen writes the search's own settings
# block; alchemy.css hides its tabs and keeps only the search field.
DISABLE_INDEX          = NO
HTML_DYNAMIC_MENUS     = NO
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
PAGE_OUTLINE_PANEL     = NO
TREEVIEW_WIDTH         = 240
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
GENERATE_LATEX         = NO

# No diagrams: the pages stay text and code
HAVE_DOT               = NO
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
