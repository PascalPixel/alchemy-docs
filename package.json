{
  "name": "alchemy-docs",
  "version": "0.0.47",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "bun scripts/renders.ts fetch && bun scripts/story.ts > /dev/null && bun scripts/content.ts",
    "build": "bun run content && bun scripts/figures.ts && bun --bun waku build",
    "dev": "bun run content && bun --bun waku dev",
    "start": "serve dist/public",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/og": "0.11.1",
    "cn": "^0.4.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.5",
    "lucide-react": "^1.50.0",
    "mermaid": "11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "waku": "1.0.0-rc.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "serve": "^14.2.6",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "tree-sitter-c": "0.24.1",
    "typescript": "^7.0.2",
    "vite": "8.3.7",
    "web-tree-sitter": "0.25.10"
  },
