{
  "name": "alchemy-docs",
  "version": "0.0.69",
  "private": true,
  "scripts": {
    "content": "bun scripts/renders.ts fetch && bun scripts/story.ts > /dev/null && bun scripts/content.ts && fumadocs-mdx && bun scripts/sidebar.ts",
    "build": "bun run content && next build --webpack && bun scripts/links.ts",
    "dev": "bun run content && next dev",
    "start": "serve out",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "cn": "^0.5.2",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.7",
    "lucide-react": "^1.71.0",
    "mermaid": "11.17.2",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "serve": "^14.2.7",
    "tailwindcss": "^4.3.5",
    "tree-sitter-c": "0.24.1",
    "typescript": "^7.0.2",
    "web-tree-sitter": "0.25.10"
  },
  "patchedDependencies": {
    "fumadocs-mdx@15.6.4": "patches/fumadocs-mdx@15.6.4.patch"
  }
}
